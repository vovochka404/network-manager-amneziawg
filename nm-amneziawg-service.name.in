[VPN Connection]
name=amneziawg
service=org.freedesktop.NetworkManager.amneziawg
program=@CMAKE_INSTALL_FULL_LIBEXECDIR@/nm-amneziawg-service
supports-multiple-connections=false

[libnm]
plugin=@NM_PLUGIN_DIR@/libnm-vpn-plugin-amneziawg.so

[GNOME]
auth-dialog=@CMAKE_INSTALL_FULL_LIBEXECDIR@/nm-amneziawg-auth-dialog
supports-external-ui-mode=true
