#: properties/nm-amneziawg-editor-plugin.c:100
msgid "Unknown AmneziaWG file extension"
msgstr "未知的 AmneziaWG 文件扩展名"

#: properties/nm-amneziawg-editor-plugin.c:117
#, c-format
msgid "Failed to parse AmneziaWG config file: %s"
msgstr "无法解析 AmneziaWG 配置文件：%s"

#: properties/nm-amneziawg-editor-plugin.c:118
msgid "unknown reason"
msgstr "未知原因"

#: properties/nm-amneziawg-editor.c:345
msgid "H1-H4 magic header ranges must not overlap"
msgstr "H1-H4 魔法头范围不能重叠"

#: properties/nm-amneziawg-editor.c:358
msgid "JMax must be greater than or equal to JMin"
msgstr "JMax 必须大于或等于 JMin"

#: properties/nm-amneziawg-editor.c:916
msgid "Public key is required and must be a 32-byte base64 key"
msgstr "公钥是必需的，且必须是 Base64 编码的 32 字节密钥"

#: properties/nm-amneziawg-editor.c:920
msgid "Endpoint is required and must be valid (host:port)"
msgstr "端点是必需的且必须是有效的 (主机:端口)"

#: properties/nm-amneziawg-editor.c:925
msgid "Allowed IPs must be valid subnets (e.g., 10.0.0.0/24)"
msgstr "Allowed IPs 必须是有效的子网（例如 10.0.0.0/24）"

#: properties/nm-amneziawg-editor.c:931
msgid "Preshared key must be a 32-byte base64 key or empty"
msgstr "预共享密钥必须是 Base64 编码的 32 字节密钥或为空"

#: properties/nm-amneziawg-editor.c:1251 properties/nm-amneziawg-editor.c:1264
#, c-format
msgid "Delete peer \"%s\"?"
msgstr "删除对端 \"%s\"？"

#: properties/nm-amneziawg-editor.c:1473
msgid "Peer"
msgstr "对端"

#: properties/nm-amneziawg-editor.c:1810
msgid "Could not create amneziawg object"
msgstr "无法创建 amneziawg 对象"

#: properties/nm-amneziawg-editor.c:1829
msgid "could not load UI widget"
msgstr "无法加载 UI 组件"

#: src/nm-amneziawg-auth-dialog.c:102
msgid "Private key"
msgstr "私钥"

#. TRANSLATORS: %d is the number of the peer as in its peer-N-* keys
#. * (from 0), %s its endpoint (host:port) or, without one, its public key
#: src/nm-amneziawg-auth-dialog.c:114
#, c-format
msgid "Preshared key of peer %d (%s)"
msgstr "对端 %d 的预共享密钥（%s）"

#: src/nm-amneziawg-auth-dialog.c:137
#, c-format
msgid "You need to authenticate to access the Virtual Private Network “%s”."
msgstr "您需要进行身份验证才能访问虚拟专用网络“%s”。"

#: src/nm-amneziawg-auth-dialog.c:155
msgid ""
"If a peer has no preshared key, choose “The password is not required” for "
"its preshared key in the connection editor, or run:"
msgstr ""
"如果对端没有预共享密钥，请在连接编辑器中将其预共享密钥设为“不需要密码”，或运"
"行："

#. TRANSLATORS: keep KEY as it is, the command that follows uses it
#: src/nm-amneziawg-auth-dialog.c:164
msgid ""
"A key stored for all users that is typed in here is saved only if you may "
"modify this connection. Otherwise restore it, with the key in place of KEY:"
msgstr ""
"在此输入的“为所有用户存储”的密钥，仅当您有权修改此连接时才会被保存。否则请用"
"以下命令恢复它，并将 KEY 替换为该密钥："

#: src/nm-amneziawg-auth-dialog.c:187
msgid "Authenticate VPN"
msgstr "VPN 身份验证"

#: shared/nm-utils/nm-shared-utils.c:615
#, c-format
msgid "object class '%s' has no property named '%s'"
msgstr "对象类 '%s' 没有名为 '%s' 的属性"

#: shared/nm-utils/nm-shared-utils.c:622
#, c-format
msgid "property '%s' of object class '%s' is not writable"
msgstr "对象类 '%s' 的属性 '%s' 不可写"

#: shared/nm-utils/nm-shared-utils.c:629
#, c-format
msgid ""
"construct property \"%s\" for object '%s' can't be set after construction"
msgstr "对象 '%s' 的构造属性 \"%s\" 无法在构造后设置"

#: shared/nm-utils/nm-shared-utils.c:637
#, c-format
msgid "'%s::%s' is not a valid property name; '%s' is not a GObject subtype"
msgstr "'%s::%s' 不是有效的属性名；'%s' 不是 GObject 子类型"

#: shared/nm-utils/nm-shared-utils.c:646
#, c-format
msgid "unable to set property '%s' of type '%s' from value of type '%s'"
msgstr "无法从类型 '%3$s' 的值设置类型 '%2$s' 的属性 '%1$s'"

#: shared/nm-utils/nm-shared-utils.c:656
#, c-format
msgid ""
"value \"%s\" of type '%s' is invalid or out of range for property '%s' of "
"type '%s'"
msgstr "类型 '%2$s' 的值 \"%1$s\" 对于类型 '%4$s' 的属性 '%3$s' 无效或超出范围"

#: shared/nm-utils/nm-vpn-plugin-utils.c:53
#, c-format
msgid "unable to get editor plugin name: %s"
msgstr "无法获取编辑器插件名称：%s"

#: shared/nm-utils/nm-vpn-plugin-utils.c:66
#: shared/nm-utils/nm-vpn-plugin-utils.c:135
#, c-format
msgid "missing plugin file \"%s\""
msgstr "缺少插件文件 \"%s\""

#: shared/nm-utils/nm-vpn-plugin-utils.c:141
#, c-format
msgid "cannot load editor plugin: %s"
msgstr "无法加载编辑器插件：%s"

#: shared/nm-utils/nm-vpn-plugin-utils.c:150
#, c-format
msgid "cannot load factory %s from plugin: %s"
msgstr "无法从插件加载工厂 %s：%s"

#: shared/nm-utils/nm-vpn-plugin-utils.c:176
msgid "unknown error creating editor instance"
msgstr "创建编辑器实例时发生未知错误"

#: properties/nm-amneziawg-dialog.ui:28
msgid "Edit AmneziaWG Peer"
msgstr "编辑 AmneziaWG 对端"

#: properties/nm-amneziawg-dialog.ui:41
msgid "_Cancel"
msgstr "取消(_C)"

#: properties/nm-amneziawg-dialog.ui:55
msgid "_Apply"
msgstr "应用(_A)"

#: properties/nm-amneziawg-dialog.ui:113
msgid "Public Key:"
msgstr "公钥："

#: properties/nm-amneziawg-dialog.ui:124
msgid "Base64-encoded 32-byte public key of the peer."
msgstr "对端的 Base64 编码 32 字节公钥。"

#: properties/nm-amneziawg-dialog.ui:137
msgid "Allowed IPs:"
msgstr "允许的 IP："

#: properties/nm-amneziawg-dialog.ui:148
msgid ""
"Comma-separated list of IP addresses and prefixes to route through the peer "
"(e.g., 10.0.0.0/24, 0.0.0.0/0 for all IPv4)."
msgstr ""
"要通过对端路由的 IP 地址和前缀列表，用逗号分隔（例如：10.0.0.0/24, 0.0.0.0/0 "
"表示所有 IPv4）。"

#: properties/nm-amneziawg-dialog.ui:161
msgid "Endpoint:"
msgstr "端点："

#: properties/nm-amneziawg-dialog.ui:172
msgid "Host:port of the peer endpoint (e.g., vpn.example.com:51820)."
msgstr "对端端点的主机:端口（例如：vpn.example.com:51820）。"

#: properties/nm-amneziawg-dialog.ui:185
msgid "Preshared Key:"
msgstr "预共享密钥："

#: properties/nm-amneziawg-dialog.ui:196
msgid "Optional base64-encoded 32-byte preshared key for extra security."
msgstr "可选的 Base64 编码 32 字节预共享密钥，用于额外安全。"

#: properties/nm-amneziawg-dialog.ui:207
msgid "Show preshared key"
msgstr "显示预共享密钥"

#: properties/nm-amneziawg-dialog.ui:224
msgid "Persistent Keepalive:"
msgstr "持久保活："

#: properties/nm-amneziawg-dialog.ui:235
msgid ""
"Seconds between persistent keepalive packets, as a number or range (e.g. 25 "
"or 25-35). Empty or 0 disables it. Ranges need AWG 3.1."
msgstr ""
"持久保活数据包之间的秒数，可为数字或范围（例如 25 或 25-35）。留空或 0 表示禁"
"用。范围需要 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:246
msgid "_Advanced Security"
msgstr "高级安全(_A)"

#: properties/nm-amneziawg-dialog.ui:250
msgid ""
"Enable advanced security features for this peer (junk packets, headers, "
"etc.)."
msgstr "为该对端启用高级安全功能（垃圾数据包、头部等）。"

#: properties/nm-amneziawg-dialog.ui:326
msgid "Interface"
msgstr "接口"

#: properties/nm-amneziawg-dialog.ui:346
msgid "Private Key:"
msgstr "私钥："

#: properties/nm-amneziawg-dialog.ui:360
msgid "Base64-encoded 32-byte private key for the interface."
msgstr "接口的 Base64 编码 32 字节私钥。"

#: properties/nm-amneziawg-dialog.ui:371
msgid "Show private key"
msgstr "显示私钥"

#: properties/nm-amneziawg-dialog.ui:399
msgid "Listen Port:"
msgstr "监听端口："

#: properties/nm-amneziawg-dialog.ui:413
msgid "UDP port to listen on (0 = random port)."
msgstr "监听的 UDP 端口（0 = 随机端口）。"

#: properties/nm-amneziawg-dialog.ui:444
msgid "MTU:"
msgstr "MTU："

#: properties/nm-amneziawg-dialog.ui:458
msgid "MTU of the interface (0 = auto-detect, typical values 1280-1500)."
msgstr "接口的 MTU（0 = 自动检测，典型值 1280-1500）。"

#: properties/nm-amneziawg-dialog.ui:484
msgid "FwMark:"
msgstr "防火墙标记："

#: properties/nm-amneziawg-dialog.ui:498
msgid ""
"Firewall mark for the interface (optional, used for routing/firewall rules)."
msgstr "接口的防火墙标记（可选，用于路由/防火墙规则）。"

#: properties/nm-amneziawg-dialog.ui:560
msgid "Jc:"
msgstr "Jc："

#: properties/nm-amneziawg-dialog.ui:574
msgid "Junk packet count - number of random junk sizes to use."
msgstr "垃圾数据包计数 - 使用的随机垃圾大小数量。"

#: properties/nm-amneziawg-dialog.ui:605
msgid "JMax:"
msgstr "JMax："

#: properties/nm-amneziawg-dialog.ui:619
msgid "Maximum junk packet size in bytes."
msgstr "最大垃圾数据包大小（字节）。"

#: properties/nm-amneziawg-dialog.ui:646
msgid "JMin:"
msgstr "JMin："

#: properties/nm-amneziawg-dialog.ui:660
msgid "Minimum junk packet size in bytes."
msgstr "最小垃圾数据包大小（字节）。"

#: properties/nm-amneziawg-dialog.ui:691
msgid "Junk Packets"
msgstr "垃圾数据包"

#: properties/nm-amneziawg-dialog.ui:730
msgid "S1:"
msgstr "S1："

#: properties/nm-amneziawg-dialog.ui:744
msgid "First noise packet size."
msgstr "第一个噪声数据包大小。"

#: properties/nm-amneziawg-dialog.ui:770
msgid "S2:"
msgstr "S2："

#: properties/nm-amneziawg-dialog.ui:784
msgid "Second noise packet size."
msgstr "第二个噪声数据包大小。"

#: properties/nm-amneziawg-dialog.ui:810
msgid "S3:"
msgstr "S3："

#: properties/nm-amneziawg-dialog.ui:824
msgid "Cookie reply packet junk size (max 65479)."
msgstr "Cookie 回复数据包垃圾大小（最大 65479）。"

#: properties/nm-amneziawg-dialog.ui:850
msgid "S4:"
msgstr "S4："

#: properties/nm-amneziawg-dialog.ui:864
msgid "Transport packet junk size (max 65503)."
msgstr "传输数据包垃圾大小（最大 65503）。"

#: properties/nm-amneziawg-dialog.ui:887
msgid "Noise Packet Sizes"
msgstr "噪声数据包大小"

#: properties/nm-amneziawg-dialog.ui:930
msgid "H1:"
msgstr "H1："

#: properties/nm-amneziawg-dialog.ui:944
msgid ""
"First handshake packet magic header. Format: single number (e.g., 1) or "
"range (e.g., 100-200). H1-H4 ranges must not overlap."
msgstr ""
"第一个握手数据包魔法头。格式：单个数字（例如 1）或范围（例如 100-200）。H1-"
"H4 范围不能重叠。"

#: properties/nm-amneziawg-dialog.ui:969
msgid "H2:"
msgstr "H2："

#: properties/nm-amneziawg-dialog.ui:983
msgid ""
"Second handshake packet magic header. Format: single number (e.g., 2) or "
"range (e.g., 100-200). H1-H4 ranges must not overlap."
msgstr ""
"第二个握手数据包魔法头。格式：单个数字（例如 2）或范围（例如 100-200）。H1-"
"H4 范围不能重叠。"

#: properties/nm-amneziawg-dialog.ui:1020
msgid "H3:"
msgstr "H3："

#: properties/nm-amneziawg-dialog.ui:1034
msgid ""
"Third handshake packet magic header. Format: single number (e.g., 3) or "
"range (e.g., 100-200). H1-H4 ranges must not overlap."
msgstr ""
"第三个握手数据包魔法头。格式：单个数字（例如 3）或范围（例如 100-200）。H1-"
"H4 范围不能重叠。"

#: properties/nm-amneziawg-dialog.ui:1059
msgid "H4:"
msgstr "H4："

#: properties/nm-amneziawg-dialog.ui:1073
msgid ""
"Fourth handshake packet magic header. Format: single number (e.g., 4) or "
"range (e.g., 100-200). H1-H4 ranges must not overlap."
msgstr ""
"第四个握手数据包魔法头。格式：单个数字（例如 4）或范围（例如 100-200）。H1-"
"H4 范围不能重叠。"

#: properties/nm-amneziawg-dialog.ui:1102
msgid "Magic Headers"
msgstr "魔法头"

#: properties/nm-amneziawg-dialog.ui:1139
msgid "I1:"
msgstr "I1："

#: properties/nm-amneziawg-dialog.ui:1153
msgid ""
"First init packet content (CPS format). Tags: &lt;r N&gt; (random bytes), "
"&lt;rc N&gt; (random ASCII), &lt;rd N&gt; (random digits), &lt;c&gt; "
"(counter), &lt;t&gt; (timestamp), &lt;b 0xHEX&gt; (static bytes). Example: "
"&lt;r 16&gt;&lt;c&gt;&lt;t&gt;&lt;b 0xDEADBEEF&gt;"
msgstr ""
"第一个初始化数据包的内容（CPS 格式）。标签：&lt;r N&gt;（随机字节）、&lt;rc "
"N&gt;（随机 ASCII 字符）、&lt;rd N&gt;（随机数字）、&lt;c&gt;（计数器）、&lt;"
"t&gt;（时间戳）、&lt;b 0xHEX&gt;（固定字节）。示例：&lt;r 16&gt;&lt;c&gt;&lt;"
"t&gt;&lt;b 0xDEADBEEF&gt;"

#: properties/nm-amneziawg-dialog.ui:1178
msgid "I2:"
msgstr "I2："

#: properties/nm-amneziawg-dialog.ui:1192
msgid ""
"Second init packet content (CPS format). Tags: &lt;r N&gt; (random bytes), "
"&lt;rc N&gt; (random ASCII), &lt;rd N&gt; (random digits), &lt;c&gt; "
"(counter), &lt;t&gt; (timestamp), &lt;b 0xHEX&gt; (static bytes). Example: "
"&lt;rc 10&gt;&lt;t&gt;"
msgstr ""
"第二个初始化数据包的内容（CPS 格式）。标签：&lt;r N&gt;（随机字节）、&lt;rc "
"N&gt;（随机 ASCII 字符）、&lt;rd N&gt;（随机数字）、&lt;c&gt;（计数器）、&lt;"
"t&gt;（时间戳）、&lt;b 0xHEX&gt;（固定字节）。示例：&lt;rc 10&gt;&lt;t&gt;"

#: properties/nm-amneziawg-dialog.ui:1217
msgid "I3:"
msgstr "I3："

#: properties/nm-amneziawg-dialog.ui:1231
msgid ""
"Third init packet content (CPS format). Tags: &lt;r N&gt; (random bytes), "
"&lt;rc N&gt; (random ASCII), &lt;rd N&gt; (random digits), &lt;c&gt; "
"(counter), &lt;t&gt; (timestamp), &lt;b 0xHEX&gt; (static bytes). Example: "
"&lt;b 0xDEADBEEF&gt;"
msgstr ""
"第三个初始化数据包的内容（CPS 格式）。标签：&lt;r N&gt;（随机字节）、&lt;rc "
"N&gt;（随机 ASCII 字符）、&lt;rd N&gt;（随机数字）、&lt;c&gt;（计数器）、&lt;"
"t&gt;（时间戳）、&lt;b 0xHEX&gt;（固定字节）。示例：&lt;b 0xDEADBEEF&gt;"

#: properties/nm-amneziawg-dialog.ui:1256
msgid "I4:"
msgstr "I4："

#: properties/nm-amneziawg-dialog.ui:1270
msgid ""
"Fourth init packet content (CPS format). Tags: &lt;r N&gt; (random bytes), "
"&lt;rc N&gt; (random ASCII), &lt;rd N&gt; (random digits), &lt;c&gt; "
"(counter), &lt;t&gt; (timestamp), &lt;b 0xHEX&gt; (static bytes). Example: "
"&lt;r 16&gt;&lt;t&gt;"
msgstr ""
"第四个初始化数据包的内容（CPS 格式）。标签：&lt;r N&gt;（随机字节）、&lt;rc "
"N&gt;（随机 ASCII 字符）、&lt;rd N&gt;（随机数字）、&lt;c&gt;（计数器）、&lt;"
"t&gt;（时间戳）、&lt;b 0xHEX&gt;（固定字节）。示例：&lt;r 16&gt;&lt;t&gt;"

#: properties/nm-amneziawg-dialog.ui:1295
msgid "I5:"
msgstr "I5："

#: properties/nm-amneziawg-dialog.ui:1309
msgid ""
"Fifth init packet content (CPS format). Tags: &lt;r N&gt; (random bytes), "
"&lt;rc N&gt; (random ASCII), &lt;rd N&gt; (random digits), &lt;c&gt; "
"(counter), &lt;t&gt; (timestamp), &lt;b 0xHEX&gt; (static bytes). Example: "
"&lt;b 0xAABBCCDD&gt;&lt;rc 5&gt;&lt;rd 3&gt;&lt;c&gt;"
msgstr ""
"第五个初始化数据包的内容（CPS 格式）。标签：&lt;r N&gt;（随机字节）、&lt;rc "
"N&gt;（随机 ASCII 字符）、&lt;rd N&gt;（随机数字）、&lt;c&gt;（计数器）、&lt;"
"t&gt;（时间戳）、&lt;b 0xHEX&gt;（固定字节）。示例：&lt;b 0xAABBCCDD&gt;&lt;"
"rc 5&gt;&lt;rd 3&gt;&lt;c&gt;"

#: properties/nm-amneziawg-dialog.ui:1331
msgid "Init Packet Content"
msgstr "初始化数据包内容"

#: properties/nm-amneziawg-dialog.ui:1369
msgid "Header protection key:"
msgstr "头部保护密钥："

#: properties/nm-amneziawg-dialog.ui:1383
msgid ""
"Base64-encoded 32-byte key used to protect packet headers. AWG 3.1 only; "
"leave empty for older servers."
msgstr ""
"用于保护数据包头部的 Base64 编码 32 字节密钥。仅限 AWG 3.1；旧版服务器请留"
"空。"

#: properties/nm-amneziawg-dialog.ui:1408
msgid "Content padding addition:"
msgstr "内容附加填充："

#: properties/nm-amneziawg-dialog.ui:1422
msgid ""
"Random padding added to every packet, as a single number (e.g. 10) or a "
"range (e.g. 2-10), 0-65535. AWG 3.1 only."
msgstr ""
"添加到每个数据包的随机填充，可为单个数字（例如 10）或范围（例如 2-10），"
"0-65535。仅限 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:1447
msgid "Rekey after time:"
msgstr "重新协商密钥时间："

#: properties/nm-amneziawg-dialog.ui:1461
msgid ""
"Seconds after which a session is rekeyed, as a number or range (e.g. "
"115-125). AWG 3.1 only."
msgstr ""
"会话重新协商密钥前的秒数，可为数字或范围（例如 115-125）。仅限 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:1486
msgid "Rekey timeout:"
msgstr "重新协商密钥超时："

#: properties/nm-amneziawg-dialog.ui:1500
msgid ""
"Seconds between rekey attempts, as a number or range (e.g. 5-6). AWG 3.1 "
"only."
msgstr "重新协商密钥尝试之间的秒数，可为数字或范围（例如 5-6）。仅限 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:1525
msgid "Reject after time:"
msgstr "拒绝时间："

#: properties/nm-amneziawg-dialog.ui:1539
msgid ""
"Seconds after which a session is dropped, as a number or range (e.g. "
"175-185). AWG 3.1 only."
msgstr "会话被丢弃前的秒数，可为数字或范围（例如 175-185）。仅限 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:1564
msgid "Keepalive timeout:"
msgstr "保活超时："

#: properties/nm-amneziawg-dialog.ui:1578
msgid ""
"Seconds before a keepalive is sent, as a number or range (e.g. 10-12). AWG "
"3.1 only."
msgstr "发送保活数据包前的秒数，可为数字或范围（例如 10-12）。仅限 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:1603
msgid "Max handshake attempts:"
msgstr "最大握手尝试次数："

#: properties/nm-amneziawg-dialog.ui:1617
msgid ""
"How many handshake attempts are made, as a number or range (e.g. 16-20). AWG "
"3.1 only."
msgstr "握手尝试的次数，可为数字或范围（例如 16-20）。仅限 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:1642
msgid "Random trailers"
msgstr "随机尾部数据"

#: properties/nm-amneziawg-dialog.ui:1656
msgid "Append random data to every packet. AWG 3.1 only."
msgstr "在每个数据包末尾附加随机数据。仅限 AWG 3.1。"

#: properties/nm-amneziawg-dialog.ui:1680
msgid "Disable cookies"
